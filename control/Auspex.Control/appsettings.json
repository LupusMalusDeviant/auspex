{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auspex": {
    "BaseUrl": "http://127.0.0.1:5380",
    "Token": ""
  },
  "Analytics": {
    "Enabled": true,
    "ConnectionString": "Data Source=var/analytics.db",
    "PollInterval": "00:00:05",
    "BatchSize": 1000,
    "RetentionDays": 90,
    "DetectionInterval": "00:05:00",
    "BaselineWarmup": "2.00:00:00",
    "WarmingEnabled": true,
    "WarmingInterval": "00:30:00",
    "WarmingTop": 200,
    "WarmingDays": 7
  },
  "Notifications": {
    "Enabled": true,
    "Marker": "AUSPEX-FUND",
    "MinSeverity": "warn",
    "MaxPerRun": 20,
    "MaxAge": "06:00:00"
  },
  "Auth": {
    "Enabled": true,
    "Username": "admin",
    "PasswordHash": "",
    "SessionLifetime": "7.00:00:00",
    "KeyPath": "var/keys",
    "TrustedProxies": []
  },
  "Rules": {
    "Enabled": true,
    "AllowPath": "var/allowlist.txt",
    "BlockPath": "var/blocklist.txt"
  },
  "Router": {
    "Kind": "fritzbox",
    "Host": "192.168.1.1",
    "Port": 49000,
    "TlsPort": 49443,
    "User": "",
    "Password": "",
    "ReadOnly": false
  }
}
